# Origine exacte, sans slash final
APP_URL=http://localhost:3000
ALLOWED_GOOGLE_EMAIL=
APP_SESSION_SECRET=
# Aliases locaux également acceptés : ALLOWED_EMAIL et TOKEN_ENCRYPTION_KEY
# openssl rand -hex 32 (32 octets)
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Obtenus après connexion puis Initialiser mon espace
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
# npm run google:connect : écrit le jeton chiffré dans .env.local
GOOGLE_REFRESH_TOKEN_ENCRYPTED=
# Alternative existante, exclusivement background :
GOOGLE_REFRESH_TOKEN=

# IA : OpenRouter gratuit recommandé pour démarrer à 0 €.
# Si AI_PROVIDER est vide, Ubique choisit OpenRouter si OPENROUTER_API_KEY est présent,
# sinon OpenAI si OPENAI_API_KEY est présent.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FAST_MODEL=openrouter/free
# Refuse par défaut les endpoints qui collectent les données pour entraînement.
OPENROUTER_DATA_COLLECTION=deny
# ZDR strict : meilleure confidentialité, mais peut réduire la disponibilité gratuite.
OPENROUTER_ZDR=false
# Alternative OpenAI payante/future : laisser vide si vous restez en gratuit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_FAST_MODEL=gpt-5.6-luna

TAVILY_API_KEY=
CRON_SECRET=
# Démonstration uniquement : données fictives locales au navigateur, jamais Google
NEXT_PUBLIC_DEMO_MODE=false
