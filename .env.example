# App
APP_URL=http://localhost:3000
APP_SESSION_SECRET=replace-with-a-long-random-secret
APP_TIME_ZONE=Europe/Paris
ALLOWED_GOOGLE_EMAIL=

# OpenAI
# Never commit real keys. Keep the main model configurable for application preparation,
# and a cheaper/faster model for classification/watch tasks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_FAST_MODEL=gpt-5.6-luna

# Google OAuth / Gmail / Drive / Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional but required for unattended Vercel cron jobs.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Optional web research
TAVILY_API_KEY=

# Cron
CRON_SECRET=
