{
  "name": "ubique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "google:connect": "node --import tsx scripts/google-connect.ts",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run security:scan && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
